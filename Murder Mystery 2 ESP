local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local function applyHighlight(target, name, color)
    local highlight = target:FindFirstChild(name)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = name
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end
    
    for _, child in ipairs(target:GetChildren()) do
        if child:IsA("Highlight") and child.Name ~= name then
            child.Enabled = false
        end
    end

    highlight.FillColor = color
    highlight.Enabled = true
end

local function updatePlayerHighlight(player)
    if player == LocalPlayer then return end
    
    local char = player.Character
    if not char or not char:Parent() then return end

    local backpack = player:FindFirstChildOfClass("Backpack")

    local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
    local hasGun = (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Gun")

    if hasKnife then
        applyHighlight(char, "RoleHighlight", Color3.fromRGB(255, 0, 0))
    elseif hasGun then
        applyHighlight(char, "RoleHighlight", Color3.fromRGB(0, 100, 255))
    else
        applyHighlight(char, "RoleHighlight", Color3.fromRGB(0, 255, 0))
    end
end

local function checkGunDrop(object)
    if object.Name == "GunDrop" and object:IsA("BasePart") then
        applyHighlight(object, "RoleHighlight", Color3.fromRGB(255, 255, 0))
    elseif object:IsA("Model") then
        local gun = object:FindFirstChild("GunDrop")
        if gun and gun:IsA("BasePart") then
            applyHighlight(gun, "RoleHighlight", Color3.fromRGB(255, 255, 0))
        end
    end
end

Workspace.ChildAdded:Connect(function(child)
    task.defer(checkGunDrop, child)
end)

for _, child in ipairs(Workspace:GetChildren()) do
    checkGunDrop(child)
end

task.spawn(function()
    while true do
        for _, player in ipairs(Players:GetPlayers()) do
            updatePlayerHighlight(player)
        end
        task.wait(0.25)
    end
end)

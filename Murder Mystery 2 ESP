local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local function getHighlight(target, name, color)
    local highlight = target:FindFirstChild(name)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = name
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end
    highlight.FillColor = color
    highlight.Enabled = true
    return highlight
end

local function disableHighlight(target, name)
    local highlight = target:FindFirstChild(name)
    if highlight then
        highlight.Enabled = false
    end
end

local function scanForGun()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") then
            local gun = child:FindFirstChild("GunDrop")
            if gun and gun:IsA("BasePart") then
                getHighlight(gun, "GunDropHighlight", Color3.new(1, 1, 0))
            end
        end
    end

    local directGun = Workspace:FindFirstChild("GunDrop")
    if directGun and directGun:IsA("BasePart") then
        getHighlight(directGun, "GunDropHighlight", Color3.new(1, 1, 0))
    end
end

task.spawn(function()
    while true do
        scanForGun()
        task.wait(1)
    end
end)

RunService.Heartbeat:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer and player.Character then
            local char = player.Character
            local backpack = player:FindFirstChild("Backpack")

            local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
            local hasGun = (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Gun")

            if hasKnife then
                disableHighlight(char, "GunHighlight")
                disableHighlight(char, "DefaultHighlight")
                getHighlight(char, "KnifeHighlight", Color3.new(1, 0, 0))
            elseif hasGun then
                disableHighlight(char, "KnifeHighlight")
                disableHighlight(char, "DefaultHighlight")
                getHighlight(char, "GunHighlight", Color3.new(0, 0, 1))
            else
                disableHighlight(char, "KnifeHighlight")
                disableHighlight(char, "GunHighlight")
                getHighlight(char, "DefaultHighlight", Color3.new(0, 1, 0))
            end
        end
    end
end)

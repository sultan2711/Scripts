local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local HIGHLIGHT_NAME = "RoleHighlight"

local COLOR_MURDERER = Color3.fromRGB(255, 0, 0)
local COLOR_SHERIFF  = Color3.fromRGB(0, 0, 255)
local COLOR_INNOCENT = Color3.fromRGB(0, 255, 0)
local COLOR_GUNDROP  = Color3.fromRGB(255, 255, 0)

local function getOrCreateHighlight(target, name)
    local highlight = target:FindFirstChild(name)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = name
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end
    return highlight
end

local function updatePlayerHighlight(player)
    if player == LocalPlayer then return end
    
    local char = player.Character
    if not char then return end

    local backpack = player:FindFirstChild("Backpack")

    local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or char:FindFirstChild("Knife")
    local hasGun = (backpack and backpack:FindFirstChild("Gun")) or char:FindFirstChild("Gun")

    local highlight = getOrCreateHighlight(char, HIGHLIGHT_NAME)

    if hasKnife then
        highlight.FillColor = COLOR_MURDERER
        highlight.Enabled = true
    elseif hasGun then
        highlight.FillColor = COLOR_SHERIFF
        highlight.Enabled = true
    else
        highlight.FillColor = COLOR_INNOCENT
        highlight.Enabled = true
    end
end

local function setupPlayerListeners(player)
    if player == LocalPlayer then return end

    local function onCharacterAdded(char)
        updatePlayerHighlight(player)

        char.ChildAdded:Connect(function() updatePlayerHighlight(player) end)
        char.ChildRemoved:Connect(function() updatePlayerHighlight(player) end)
    end

    if player.Character then
        onCharacterAdded(player.Character)
    end
    player.CharacterAdded:Connect(onCharacterAdded)

    player.ChildAdded:Connect(function(child)
        if child.Name == "Backpack" then
            child.ChildAdded:Connect(function() updatePlayerHighlight(player) end)
            child.ChildRemoved:Connect(function() updatePlayerHighlight(player) end)
            updatePlayerHighlight(player)
        end
    end)

    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        backpack.ChildAdded:Connect(function() updatePlayerHighlight(player) end)
        backpack.ChildRemoved:Connect(function() updatePlayerHighlight(player) end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayerListeners(player)
end
Players.PlayerAdded:Connect(setupPlayerListeners)

local function checkAndHighlightGun(instance)
    if instance.Name == "GunDrop" and instance:IsA("BasePart") then
        local hl = getOrCreateHighlight(instance, "GunDropHighlight")
        hl.FillColor = COLOR_GUNDROP
        hl.Enabled = true
    elseif instance:IsA("Model") then
        local gun = instance:FindFirstChild("GunDrop")
        if gun and gun:IsA("BasePart") then
            local hl = getOrCreateHighlight(gun, "GunDropHighlight")
            hl.FillColor = COLOR_GUNDROP
            hl.Enabled = true
        end
    end
end

Workspace.ChildAdded:Connect(checkAndHighlightGun)

for _, child in ipairs(Workspace:GetChildren()) do
    checkAndHighlightGun(child)
end
